# HTTPS certificate from Let's Encrypt is fetched automatically for SITE_ADDRESS.
{$SITE_ADDRESS} {
	encode gzip
	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}
	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}
	# Public server address and anon key, read by CI when it builds the game.
	handle /chimora.json {
		root * /srv/public
		file_server
	}
	respond 404
}
