config_version=5

[application]
config/name="Chimora"
config/name_localized={
"en": "Chimora",
"de": "Chimora",
"es": "Chimora",
"fr": "Chimora",
"it": "Chimora",
"ja": "Chimora",
"ko": "Chimora",
"nl": "Chimora",
"pl": "Chimora",
"pt_BR": "Chimora",
"ru": "Chimora",
"tr": "Chimora",
"zh_CN": "Chimora",
"zh_TW": "Chimora"
}
config/icon="res://art/icon/icon_192.png"
run/main_scene="res://scenes/ui/Title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/quit_on_go_back=false

[audio]

general/ios/session_category=0
general/ios/mix_with_others=true

[autoload]
GameState="*res://scripts/core/GameState.gd"
EraManager="*res://scripts/core/EraManager.gd"
VirtualPad="*res://scripts/ui/VirtualPad.gd"
SaveManager="*res://scripts/core/SaveManager.gd"
Sound="*res://scripts/core/Sound.gd"
MusicDirector="*res://scripts/core/MusicDirector.gd"
Juice="*res://scripts/core/Juice.gd"
Haptics="*res://scripts/core/Haptics.gd"
Ticker="*res://scripts/ui/Ticker.gd"
Online="*res://scripts/online/Online.gd"
Billing="*res://scripts/shop/Billing.gd"

[display]
window/size/viewport_width=144
window/size/viewport_height=256
window/size/window_width_override=432
window/size/window_height_override=768
window/size/resizable=true
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="fractional"
window/handheld/orientation=6

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true

[internationalization]

locale/translations=PackedStringArray("res://ios/lproj/de.po", "res://ios/lproj/es.po", "res://ios/lproj/fr.po", "res://ios/lproj/it.po", "res://ios/lproj/ja.po", "res://ios/lproj/ko.po", "res://ios/lproj/nl.po", "res://ios/lproj/pl.po", "res://ios/lproj/pt_BR.po", "res://ios/lproj/ru.po", "res://ios/lproj/tr.po", "res://ios/lproj/zh_CN.po", "res://ios/lproj/zh_TW.po")

[editor_plugins]

enabled=PackedStringArray("res://addons/chimora_appupdate/plugin.cfg", "res://addons/chimora_billing/plugin.cfg", "res://addons/chimora_deeplink/plugin.cfg", "res://addons/chimora_notify/plugin.cfg", "res://addons/chimora_review/plugin.cfg", "res://addons/gut/plugin.cfg")
