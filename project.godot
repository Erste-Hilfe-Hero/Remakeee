config_version=5

[application]
config/name="Chimora"
config/icon="res://art/icon/icon_192.png"
run/main_scene="res://scenes/ui/Title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/quit_on_go_back=false

[audio]

general/ios/session_category=0
general/ios/mix_with_others=true

[autoload]
GameState="*res://scripts/core/GameState.gd"
EraManager="*res://scripts/core/EraManager.gd"
VirtualPad="*res://scripts/ui/VirtualPad.gd"
SaveManager="*res://scripts/core/SaveManager.gd"
Sound="*res://scripts/core/Sound.gd"
MusicDirector="*res://scripts/core/MusicDirector.gd"
Juice="*res://scripts/core/Juice.gd"
Haptics="*res://scripts/core/Haptics.gd"
Ticker="*res://scripts/ui/Ticker.gd"
Online="*res://scripts/online/Online.gd"

[display]
window/size/viewport_width=144
window/size/viewport_height=256
window/size/window_width_override=432
window/size/window_height_override=768
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/handheld/orientation=1

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")
